{
  "server_key": "mcp_servers",
  "servers": {
    "codegraph": {
      "args": [
        "serve",
        "--mcp"
      ],
      "command": "codegraph"
    },
    "colony": {
      "args": [
        "mcp"
      ],
      "command": "~/.nvm/versions/node/v22.22.0/bin/colony",
      "enabled": true,
      "env": {
        "COLONY_HOME": "<redacted>",
        "COLONY_MCP_METRICS_MAX": "<redacted>",
        "COLONY_OBSERVATIONS_TTL_DAYS": "<redacted>",
        "COLONY_SESSION_TTL_DAYS": "<redacted>",
        "NODE_OPTIONS": "<redacted>"
      },
      "startup_timeout_sec": 60
    },
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "command": "npx"
    },
    "xbot": {
      "args": [
        "${HOME}/Documents/x-growth-bot/run-mcp.sh"
      ],
      "command": "bash",
      "enabled": false
    },
    "coolify": {
      "args": [
        "-lc",
        "<redacted secret-loading argument>"
      ],
      "command": "bash"
    },
    "gbrain": {
      "command": "~/.local/bin/gbrain-mcp-wrapper.sh",
      "enabled": false
    },
    "marva-blog": {
      "args": [
        "run",
        "--quiet",
        "--script",
        "~/Documents/soul/mcps/mcps/marva-blog/server.py"
      ],
      "command": "~/.local/bin/uv",
      "enabled": false
    },
    "obsidian-vault": {
      "args": [
        "~/Documents/ai-tools/claude-obsidian"
      ],
      "command": "~/.codex/bin/mcpvault-stdio-keepalive.mjs",
      "enabled": false
    },
    "polymarket-live": {
      "args": [
        "run",
        "--quiet",
        "--script",
        "~/Documents/soul/mcps/mcps/polymarket-live/server.py"
      ],
      "command": "~/.local/bin/uv",
      "enabled": false
    },
    "ruflo": {
      "args": [
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "command": "npx",
      "enabled": false
    },
    "soul-skills": {
      "args": [
        "run",
        "--quiet",
        "--script",
        "~/Documents/soul/mcps/mcps/soul-skills/server.py"
      ],
      "command": "~/.local/bin/uv",
      "enabled": false
    },
    "cue-tty-watch": {
      "command": "/home/deadpool/Documents/cue/resources/mcps/cue-tty-watch/bin/cue-tty-watch"
    },
    "google-ads-mcp": {
      "command": "pipx",
      "args": [
        "run",
        "--spec",
        "git+https://github.com/googleads/google-ads-mcp.git",
        "google-ads-mcp"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}",
        "GOOGLE_PROJECT_ID": "${GOOGLE_PROJECT_ID}",
        "GOOGLE_ADS_DEVELOPER_TOKEN": "${GOOGLE_ADS_DEVELOPER_TOKEN}",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "${GOOGLE_ADS_LOGIN_CUSTOMER_ID}"
      }
    },
    "google-analytics-mcp": {
      "command": "pipx",
      "args": [
        "run",
        "--spec",
        "git+https://github.com/googleanalytics/google-analytics-mcp.git",
        "google-analytics-mcp"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}",
        "GOOGLE_PROJECT_ID": "${GOOGLE_PROJECT_ID}"
      }
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${HOME}"
      ]
    }
  },
  "source": "codex",
  "source_path": "~/.codex/config.toml"
}
