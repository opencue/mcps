{
  "server_key": "mcp_servers",
  "servers": {
    "Higgsfield": {
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "MedusaDocs": {
      "enabled": false,
      "url": "https://docs.medusajs.com/mcp"
    },
    "colony": {
      "args": [
        "mcp"
      ],
      "command": "~/.nvm/versions/node/v22.22.0/bin/colony",
      "env": {
        "COLONY_HOME": "<redacted>"
      },
      "tools": {
        "attention_inbox": {
          "approval_mode": "approve"
        },
        "hivemind_context": {
          "approval_mode": "approve"
        }
      }
    },
    "coolify": {
      "args": [
        "-lc",
        "<redacted secret-loading argument>"
      ],
      "command": "bash"
    },
    "gbrain": {
      "args": [
        "-lc",
        "export GBRAIN_HOME=/tmp/gbrain-codex; cfg=\"$GBRAIN_HOME/.gbrain/config.json\"; db=\"$GBRAIN_HOME/.gbrain/brain.pglite\"; lock=\"$db/.gbrain-lock\"; if [ -d \"$lock\" ]; then pid=\"\"; if [ -f \"$lock/lock\" ]; then pid=\"$(sed -n 's/.*\"pid\":\\([0-9][0-9]*\\).*/\\1/p' \"$lock/lock\" | head -1)\"; fi; if [ -z \"$pid\" ] || ! ps -p \"$pid\" >/dev/null 2>&1 || ! ps -p \"$pid\" -o args= | grep -q '[g]brain'; then rm -rf \"$lock\"; fi; fi; if [ ! -f \"$cfg\" ]; then /home/deadpool/.bun/bin/gbrain init --pglite >/tmp/gbrain-mcp-init.log 2>&1; fi; exec /home/deadpool/.bun/bin/gbrain serve 2>/tmp/gbrain-mcp.stderr"
      ],
      "command": "bash",
      "startup_timeout_sec": 60.0
    },
    "hostinger-api": {
      "args": [
        "-lc",
        "<redacted secret-loading argument>"
      ],
      "command": "bash"
    },
    "letsfg": {
      "command": "~/.nvm/versions/node/v22.22.0/bin/letsfg-mcp",
      "env": {
        "LETSFG_PYTHON": "<redacted>"
      },
      "startup_timeout_sec": 20.0
    },
    "obsidian-vault": {
      "args": [
        "-y",
        "@bitbonsai/mcpvault@latest",
        "~/Documents/claude-obsidian"
      ],
      "command": "npx"
    },
    "recodee": {
      "command": "~/Documents/recodee/.venv/bin/recodee-mcp",
      "env": {
        "RECODEE_BASE_URL": "<redacted>"
      }
    },
    "soul-skills": {
      "args": [
        "run",
        "--quiet",
        "--script",
        "~/Documents/soul/mcps/mcps/soul-skills/server.py"
      ],
      "command": "~/.local/bin/uv"
    }
  },
  "source": "codex",
  "source_path": "~/.codex/config.toml"
}
