{
  "server_key": "mcpServers",
  "servers": {
    "buywhere": {
      "command": "npx",
      "args": [
        "-y",
        "@buywhere/mcp-server"
      ],
      "env": {
        "BUYWHERE_API_KEY": "${BUYWHERE_API_KEY}"
      }
    },
    "strapi-docs": {
      "type": "http",
      "url": "https://strapi-docs.mcp.kapa.ai"
    },
    "strapi-mcp": {
      "type": "http",
      "url": "${STRAPI_URL}/mcp",
      "headers": {
        "Authorization": "Bearer ${STRAPI_ADMIN_TOKEN}"
      }
    },
    "financial-datasets": {
      "command": "/home/deadpool/.local/bin/uv",
      "args": [
        "--directory",
        "/home/deadpool/.config/cue/mcp-servers/financial-datasets",
        "run",
        "server.py"
      ],
      "env": {
        "FINANCIAL_DATASETS_API_KEY": "${FINANCIAL_DATASETS_API_KEY}"
      }
    },
    "postgres-pro": {
      "command": "uvx",
      "args": [
        "postgres-mcp",
        "--access-mode=restricted"
      ],
      "env": {
        "DATABASE_URI": "${DATABASE_URI}"
      }
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--read-only"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
      }
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "kroschuorder": {
      "args": [
        "tsx",
        "~/Documents/Kroschuorder/mcp/server.ts"
      ],
      "command": "npx",
      "env": {
        "KROSCHUORDER_API_URL": "<redacted>"
      }
    },
    "cue-tty-watch": {
      "command": "/home/deadpool/Documents/cue/resources/mcps/cue-tty-watch/bin/cue-tty-watch"
    },
    "cue-dashboard": {
      "command": "/home/deadpool/Documents/cue/resources/mcps/cue-dashboard/bin/cue-dashboard"
    },
    "agentshield": {
      "command": "/home/deadpool/Documents/cue/resources/mcps/agentshield/bin/agentshield"
    },
    "lightpanda": {
      "command": "/home/deadpool/lightpanda",
      "args": [
        "mcp"
      ]
    },
    "gbrain": {
      "command": "/home/deadpool/.local/bin/gbrain-mcp-wrapper.sh"
    },
    "figma": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_API_KEY}"
      }
    },
    "secret-mcp": {
      "command": "bash",
      "args": [
        "-lc",
        "cd /home/deadpool/Documents/recodee/tools/secret-mcp && export INFISICAL_API_URL=\"${INFISICAL_API_URL:-http://127.0.0.1:8089}\" INFISICAL_WORKSPACE_ID=\"${INFISICAL_WORKSPACE_ID:-}\" INFISICAL_ENVIRONMENT=\"${INFISICAL_ENVIRONMENT:-dev}\" INFISICAL_TOKEN_FILE=\"${INFISICAL_TOKEN_FILE:-$HOME/.config/recodee/infisical-token}\" INFISICAL_SECRET_REFRESH_SECONDS=\"${INFISICAL_SECRET_REFRESH_SECONDS:-300}\" SECRET_MCP_AGENT_IDENTITY=\"${SECRET_MCP_AGENT_IDENTITY:-${USER:-unknown}@${HOSTNAME:-localhost}}\"; exec /home/deadpool/Documents/recodee/.venv/bin/python -m secret_mcp"
      ]
    },
    "x-api": {
      "command": "npm",
      "args": [
        "start"
      ],
      "cwd": "${HOME}/.x-api-mcp",
      "env": {
        "X_API_KEY": "${X_API_KEY}",
        "X_API_SECRET": "${X_API_SECRET}",
        "X_BEARER_TOKEN": "${X_BEARER_TOKEN}",
        "X_ACCESS_TOKEN": "${X_ACCESS_TOKEN}",
        "X_ACCESS_TOKEN_SECRET": "${X_ACCESS_TOKEN_SECRET}"
      }
    },
    "xbot": {
      "command": "bash",
      "args": [
        "${HOME}/Documents/x-growth-bot/run-mcp.sh"
      ]
    },
    "trendradar": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/sansan0/TrendRadar.git",
        "trendradar-mcp"
      ],
      "env": {}
    },
    "mapi-devdocs": {
      "type": "http",
      "url": "https://merchantapi.googleapis.com/devdocs/mcp/"
    },
    "mitre-attack": {
      "command": "/home/deadpool/.local/bin/mitre-attack-mcp",
      "args": [],
      "env": {}
    },
    "cve-search": {
      "command": "uv",
      "args": [
        "--directory",
        "/home/deadpool/.config/cue/cache/cve-search_mcp",
        "run",
        "main.py"
      ],
      "env": {}
    },
    "hexstrike-ai": {
      "command": "/home/deadpool/.config/cue/cache/hexstrike-ai/hexstrike-env/bin/python3",
      "args": [
        "/home/deadpool/.config/cue/cache/hexstrike-ai/hexstrike_mcp.py",
        "--server",
        "http://localhost:8888"
      ],
      "env": {}
    },
    "shodan": {
      "command": "npx",
      "args": [
        "-y",
        "@burtthecoder/mcp-shodan"
      ],
      "env": {
        "SHODAN_API_KEY": "${SHODAN_API_KEY}"
      }
    },
    "postiz": {
      "type": "http",
      "url": "http://localhost:4007/api/mcp/${POSTIZ_API_KEY}"
    },
    "google-ads-mcp": {
      "command": "pipx",
      "args": [
        "run",
        "--spec",
        "git+https://github.com/googleads/google-ads-mcp.git",
        "google-ads-mcp"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}",
        "GOOGLE_PROJECT_ID": "${GOOGLE_PROJECT_ID}",
        "GOOGLE_ADS_DEVELOPER_TOKEN": "${GOOGLE_ADS_DEVELOPER_TOKEN}",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "${GOOGLE_ADS_LOGIN_CUSTOMER_ID}"
      }
    },
    "google-analytics-mcp": {
      "command": "pipx",
      "args": [
        "run",
        "--spec",
        "git+https://github.com/googleanalytics/google-analytics-mcp.git",
        "google-analytics-mcp"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS}",
        "GOOGLE_PROJECT_ID": "${GOOGLE_PROJECT_ID}"
      }
    },
    "google-drive-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@piotr-agier/google-drive-mcp"
      ],
      "env": {
        "GOOGLE_DRIVE_OAUTH_CREDENTIALS": "${GOOGLE_DRIVE_OAUTH_CREDENTIALS}"
      }
    },
    "Higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "postgres": {
      "command": "bash",
      "args": [
        "-lc",
        "exec npx -y @modelcontextprotocol/server-postgres \"${DATABASE_URL}\""
      ]
    },
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    },
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "@jerhadf/linear-mcp-server"
      ],
      "env": {
        "LINEAR_API_KEY": "${LINEAR_API_KEY}"
      }
    },
    "aws-docs": {
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ]
    },
    "nanobanana-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@ycse/nanobanana-mcp"
      ],
      "env": {
        "GOOGLE_AI_API_KEY": "${GOOGLE_AI_API_KEY}",
        "NANOBANANA_MODEL": "gemini-3.1-flash-image-preview"
      }
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${HOME}"
      ]
    },
    "headroom": {
      "command": "headroom",
      "args": [
        "mcp",
        "serve"
      ]
    }
  },
  "source": "claude",
  "source_path": "~/.claude/settings.json"
}
