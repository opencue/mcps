{
  "server_key": "mcpServers",
  "servers": {
    "kroschuorder": {
      "args": [
        "tsx",
        "~/Documents/Kroschuorder/mcp/server.ts"
      ],
      "command": "npx",
      "env": {
        "KROSCHUORDER_API_URL": "<redacted>"
      }
    },
    "cue-tty-watch": {
      "command": "/home/deadpool/Documents/cue/resources/mcps/cue-tty-watch/bin/cue-tty-watch"
    },
    "agentshield": {
      "command": "/home/deadpool/Documents/cue/resources/mcps/agentshield/bin/agentshield"
    },
    "x-api": {
      "command": "npm",
      "args": [
        "start"
      ],
      "cwd": "${HOME}/.x-api-mcp",
      "env": {
        "X_API_KEY": "${X_API_KEY}",
        "X_API_SECRET": "${X_API_SECRET}",
        "X_BEARER_TOKEN": "${X_BEARER_TOKEN}",
        "X_ACCESS_TOKEN": "${X_ACCESS_TOKEN}",
        "X_ACCESS_TOKEN_SECRET": "${X_ACCESS_TOKEN_SECRET}"
      }
    },
    "trendradar": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/sansan0/TrendRadar.git",
        "trendradar-mcp"
      ],
      "env": {}
    },
    "mapi-devdocs": {
      "type": "http",
      "url": "https://merchantapi.googleapis.com/devdocs/mcp/"
    },
    "mitre-attack": {
      "command": "/home/deadpool/.local/bin/mitre-attack-mcp",
      "args": [],
      "env": {}
    },
    "cve-search": {
      "command": "uv",
      "args": [
        "--directory",
        "/home/deadpool/.config/cue/cache/cve-search_mcp",
        "run",
        "main.py"
      ],
      "env": {}
    },
    "shodan": {
      "command": "npx",
      "args": [
        "-y",
        "@burtthecoder/mcp-shodan"
      ],
      "env": {
        "SHODAN_API_KEY": "${SHODAN_API_KEY}"
      }
    },
    "postiz": {
      "type": "http",
      "url": "http://localhost:4007/api/mcp/${POSTIZ_API_KEY}"
    }
  },
  "source": "claude",
  "source_path": "~/.claude/settings.json"
}
