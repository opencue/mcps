{
  "server_key": "mcpServers",
  "servers": {
    "Higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "colony": {
      "args": [
        "-lc",
        "exec colony mcp"
      ],
      "command": "bash",
      "type": "stdio"
    },
    "coolify": {
      "args": [
        "-lc",
        "<redacted secret-loading argument>"
      ],
      "command": "bash",
      "type": "stdio"
    },
    "hostinger-api": {
      "args": [
        "-lc",
        "<redacted secret-loading argument>"
      ],
      "command": "bash",
      "type": "stdio"
    },
    "letsfg": {
      "command": "~/.nvm/versions/node/v22.22.0/bin/letsfg-mcp",
      "env": {
        "LETSFG_PYTHON": "<redacted>"
      }
    },
    "obsidian-vault": {
      "args": [
        "-y",
        "@bitbonsai/mcpvault@latest",
        "~/Documents/claude-obsidian"
      ],
      "command": "npx",
      "timeout": 15,
      "type": "stdio"
    },
    "omx_code_intel": {
      "args": [
        "~/Documents/recodee/oh-my-codex/dist/mcp/code-intel-server.js"
      ],
      "command": "node"
    },
    "omx_memory": {
      "args": [
        "~/Documents/recodee/oh-my-codex/dist/mcp/memory-server.js"
      ],
      "command": "node"
    },
    "omx_state": {
      "args": [
        "~/Documents/recodee/oh-my-codex/dist/mcp/state-server.js"
      ],
      "command": "node"
    },
    "omx_trace": {
      "args": [
        "~/Documents/recodee/oh-my-codex/dist/mcp/trace-server.js"
      ],
      "command": "node"
    },
    "omx_wiki": {
      "args": [
        "~/Documents/recodee/oh-my-codex/dist/mcp/wiki-server.js"
      ],
      "command": "node"
    },
    "recodee": {
      "command": "~/Documents/recodee/.venv/bin/recodee-mcp",
      "env": {
        "RECODEE_BASE_URL": "<redacted>"
      }
    },
    "soul-skills": {
      "args": [
        "run",
        "--quiet",
        "--script",
        "~/Documents/soul/mcps/mcps/soul-skills/server.py"
      ],
      "command": "~/.local/bin/uv"
    }
  },
  "source": "claude_runtime",
  "source_path": "~/.claude.json"
}
