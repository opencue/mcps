{
  "server_key": "mcpServers",
  "servers": {
    "codegraph": {
      "args": [
        "serve",
        "--mcp"
      ],
      "command": "codegraph",
      "type": "stdio"
    },
    "colony": {
      "args": [
        "mcp"
      ],
      "command": "~/.nvm/versions/node/v22.22.0/bin/colony",
      "env": {
        "COLONY_HOME": "<redacted>",
        "COLONY_MCP_METRICS_MAX": "<redacted>",
        "COLONY_OBSERVATIONS_TTL_DAYS": "<redacted>",
        "COLONY_SESSION_TTL_DAYS": "<redacted>",
        "NODE_OPTIONS": "<redacted>"
      }
    },
    "drawio": {
      "args": [
        "-y",
        "@drawio/mcp"
      ],
      "command": "npx",
      "env": {},
      "type": "stdio"
    },
    "gbrain": {
      "command": "~/.local/bin/gbrain-mcp-wrapper.sh"
    },
    "letsfg": {
      "command": "~/.nvm/versions/node/v22.22.0/bin/letsfg-mcp",
      "env": {
        "LETSFG_PYTHON": "<redacted>"
      }
    },
    "marva-blog": {
      "args": [
        "run",
        "--quiet",
        "--script",
        "~/Documents/soul/mcps/mcps/marva-blog/server.py"
      ],
      "command": "~/.local/bin/uv"
    },
    "obsidian-vault": {
      "args": [
        "~/Documents/ai-tools/claude-obsidian"
      ],
      "command": "~/.codex/bin/mcpvault-stdio-keepalive.mjs"
    },
    "playwright": {
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "command": "npx",
      "env": {}
    },
    "recodee": {
      "command": "~/Documents/recodee/.venv/bin/recodee-mcp",
      "env": {
        "RECODEE_BASE_URL": "<redacted>"
      }
    },
    "cue-tty-watch": {
      "command": "/home/deadpool/Documents/cue/resources/mcps/cue-tty-watch/bin/cue-tty-watch"
    },
    "x-api": {
      "command": "npm",
      "args": [
        "start"
      ],
      "cwd": "${HOME}/.x-api-mcp",
      "env": {
        "X_API_KEY": "${X_API_KEY}",
        "X_API_SECRET": "${X_API_SECRET}",
        "X_BEARER_TOKEN": "${X_BEARER_TOKEN}",
        "X_ACCESS_TOKEN": "${X_ACCESS_TOKEN}",
        "X_ACCESS_TOKEN_SECRET": "${X_ACCESS_TOKEN_SECRET}"
      }
    },
    "xbot": {
      "command": "bash",
      "args": [
        "${HOME}/Documents/x-growth-bot/run-mcp.sh"
      ]
    },
    "reddit": {
      "command": "npx",
      "args": [
        "reddit-mcp-server"
      ],
      "env": {
        "REDDIT_CLIENT_ID": "${REDDIT_CLIENT_ID}",
        "REDDIT_CLIENT_SECRET": "${REDDIT_CLIENT_SECRET}",
        "REDDIT_USERNAME": "${REDDIT_USERNAME}",
        "REDDIT_PASSWORD": "${REDDIT_PASSWORD}",
        "REDDIT_SAFE_MODE": "standard",
        "REDDIT_AUTH_MODE": "auto"
      }
    },
    "adloop": {
      "command": "/home/deadpool/Documents/ADS/scripts/adloop",
      "args": [
        "serve"
      ]
    },
    "google-ads-mcp": {
      "command": "/home/deadpool/Documents/ADS/scripts/google-ads-mcp",
      "args": []
    },
    "meta-ads": {
      "command": "npx",
      "args": [
        "-y",
        "meta-ads-mcp@latest"
      ],
      "env": {
        "META_ACCESS_TOKEN": "${META_ACCESS_TOKEN}",
        "META_AD_ACCOUNT_ID": "${META_AD_ACCOUNT_ID}"
      }
    },
    "mapi-devdocs": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://merchantapi.googleapis.com/devdocs/mcp"
      ]
    },
    "nanobanana-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@ycse/nanobanana-mcp"
      ],
      "env": {
        "GOOGLE_AI_API_KEY": "${GOOGLE_AI_API_KEY}",
        "NANOBANANA_MODEL": "gemini-3.1-flash-image-preview"
      }
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${HOME}"
      ]
    }
  },
  "source": "claude_runtime",
  "source_path": "~/.claude.json"
}
