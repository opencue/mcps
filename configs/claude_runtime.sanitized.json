{
  "server_key": "mcpServers",
  "servers": {
    "Higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "codegraph": {
      "args": [
        "serve",
        "--mcp"
      ],
      "command": "codegraph",
      "type": "stdio"
    },
    "colony": {
      "args": [
        "mcp"
      ],
      "command": "~/.nvm/versions/node/v22.22.0/bin/colony",
      "env": {
        "COLONY_HOME": "<redacted>",
        "COLONY_MCP_METRICS_MAX": "<redacted>",
        "COLONY_OBSERVATIONS_TTL_DAYS": "<redacted>",
        "COLONY_SESSION_TTL_DAYS": "<redacted>",
        "NODE_OPTIONS": "<redacted>"
      }
    },
    "coolify": {
      "args": [
        "-lc",
        "<redacted secret-loading argument>"
      ],
      "command": "bash"
    },
    "drawio": {
      "args": [
        "-y",
        "@drawio/mcp"
      ],
      "command": "npx",
      "env": {},
      "type": "stdio"
    },
    "envoult": {
      "args": [],
      "command": "~/Documents/soul/bin/envoultd",
      "env": {}
    },
    "gbrain": {
      "command": "~/.local/bin/gbrain-mcp-wrapper.sh"
    },
    "hostinger-api": {
      "args": [
        "-lc",
        "<redacted secret-loading argument>"
      ],
      "command": "bash"
    },
    "letsfg": {
      "command": "~/.nvm/versions/node/v22.22.0/bin/letsfg-mcp",
      "env": {
        "LETSFG_PYTHON": "<redacted>"
      }
    },
    "marva-blog": {
      "args": [
        "run",
        "--quiet",
        "--script",
        "~/Documents/soul/mcps/mcps/marva-blog/server.py"
      ],
      "command": "~/.local/bin/uv"
    },
    "obsidian-vault": {
      "args": [
        "~/Documents/ai-tools/claude-obsidian"
      ],
      "command": "~/.codex/bin/mcpvault-stdio-keepalive.mjs"
    },
    "playwright": {
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ],
      "command": "npx",
      "env": {}
    },
    "polymarket-live": {
      "args": [
        "run",
        "--quiet",
        "--script",
        "~/Documents/soul/mcps/mcps/polymarket-live/server.py"
      ],
      "command": "~/.local/bin/uv"
    },
    "recodee": {
      "command": "~/Documents/recodee/.venv/bin/recodee-mcp",
      "env": {
        "RECODEE_BASE_URL": "<redacted>"
      }
    },
    "soul-skills": {
      "args": [
        "run",
        "--quiet",
        "--script",
        "~/Documents/soul/mcps/mcps/soul-skills/server.py"
      ],
      "command": "~/.local/bin/uv"
    },
    "cue-tty-watch": {
      "command": "/home/deadpool/Documents/cue/resources/mcps/cue-tty-watch/bin/cue-tty-watch"
    },
    "x-api": {
      "command": "python",
      "args": [
        "server.py"
      ],
      "cwd": "${HOME}/.x-api-mcp",
      "env": {
        "X_OAUTH_CONSUMER_KEY": "${X_OAUTH_CONSUMER_KEY}",
        "X_OAUTH_CONSUMER_SECRET": "${X_OAUTH_CONSUMER_SECRET}",
        "X_BEARER_TOKEN": "${X_BEARER_TOKEN}",
        "X_API_TOOL_ALLOWLIST": "searchPostsRecent,createPosts,getUsersByUsername,getUsersMe,getPostsById,searchUsers,getUsersPosts"
      }
    }
  },
  "source": "claude_runtime",
  "source_path": "~/.claude.json"
}
