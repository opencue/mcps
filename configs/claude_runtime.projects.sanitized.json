{
  "projects": {
    "~": {
      "ruflo": {
        "args": [
          "ruflo@latest",
          "mcp",
          "start"
        ],
        "command": "npx",
        "env": {},
        "type": "stdio"
      }
    },
    "~/Documents/medusa-shops/szaloniroda/marva": {
      "resend": {
        "args": [
          "-y",
          "resend-mcp"
        ],
        "command": "npx",
        "env": {
          "RESEND_API_KEY": "<redacted>"
        },
        "type": "stdio"
      }
    }
  },
  "server_key": "projects[*].mcpServers",
  "source": "claude_runtime_projects",
  "source_path": "~/.claude.json"
}
