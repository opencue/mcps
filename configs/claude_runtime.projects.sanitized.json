{
  "projects": {
    "~": {
      "ruflo": {
        "args": [
          "ruflo@latest",
          "mcp",
          "start"
        ],
        "command": "npx",
        "env": {},
        "type": "stdio"
      }
    }
  },
  "server_key": "projects[*].mcpServers",
  "source": "claude_runtime_projects",
  "source_path": "~/.claude.json"
}
