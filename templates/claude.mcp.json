{
  "mcpServers": {
    "colony": {
      "command": "/path/to/node",
      "args": [
        "/path/to/colony/apps/cli/dist/index.js",
        "mcp"
      ]
    },
    "letsfg": {
      "command": "/path/to/letsfg-mcp",
      "args": [],
      "env": {
        "LETSFG_PYTHON": "/path/to/python"
      }
    },
    "omx_code_intel": {
      "command": "node",
      "args": [
        "/path/to/oh-my-codex/dist/mcp/code-intel-server.js"
      ]
    },
    "omx_memory": {
      "command": "node",
      "args": [
        "/path/to/oh-my-codex/dist/mcp/memory-server.js"
      ]
    },
    "omx_state": {
      "command": "node",
      "args": [
        "/path/to/oh-my-codex/dist/mcp/state-server.js"
      ]
    },
    "omx_trace": {
      "command": "node",
      "args": [
        "/path/to/oh-my-codex/dist/mcp/trace-server.js"
      ]
    },
    "omx_wiki": {
      "command": "node",
      "args": [
        "/path/to/oh-my-codex/dist/mcp/wiki-server.js"
      ]
    }
  }
}
