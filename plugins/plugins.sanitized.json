{
  "marketplaces": {
    "claude-code-skills": {
      "source": {
        "repo": "alirezarezvani/claude-skills",
        "source": "github"
      }
    },
    "thedotmack": {
      "source": {
        "repo": "thedotmack/claude-mem",
        "source": "github"
      }
    }
  },
  "plugins": {
    "claude-mem@thedotmack": {
      "enabled": true,
      "marketplace": "thedotmack",
      "mcpServers": {
        "mcp-search": {
          "args": [
            "-c",
            "_C=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"; _E=\"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}\"; _P=$({ [ -n \"$_E\" ] && printf '%s\\n' \"$_E\"; printf '%s\\n' \"$PWD/plugin\" \"$PWD\"; ls -dt \"$HOME/.codex/plugins/cache/claude-mem-local/claude-mem\"/[0-9]*/ \"$HOME/.codex/plugins/cache/thedotmack/claude-mem\"/[0-9]*/ \"$_C/plugins/cache/thedotmack/claude-mem\"/[0-9]*/ 2>/dev/null; printf '%s\\n' \"$_C/plugins/marketplaces/thedotmack/plugin\"; } | while IFS= read -r _R; do [ -d \"$_R/plugin/scripts\" ] && _Q=\"$_R/plugin\" || _Q=\"$_R\"; [ -f \"$_Q/scripts/mcp-server.cjs\" ] && { printf '%s\\n' \"$_Q\"; break; }; done); [ -n \"$_P\" ] || { echo \"claude-mem: mcp server not found\" >&2; exit 1; }; exec node \"$_P/scripts/mcp-server.cjs\""
          ],
          "command": "sh",
          "type": "stdio"
        }
      },
      "name": "claude-mem",
      "version": "13.2.0"
    },
    "engineering-advanced-skills@claude-code-skills": {
      "enabled": false,
      "marketplace": "claude-code-skills",
      "mcpServers": {},
      "name": "engineering-advanced-skills",
      "version": "2.4.4"
    },
    "engineering-skills@claude-code-skills": {
      "enabled": false,
      "marketplace": "claude-code-skills",
      "mcpServers": {},
      "name": "engineering-skills",
      "version": "2.2.3"
    },
    "frontend-design@claude-plugins-official": {
      "enabled": true,
      "marketplace": "claude-plugins-official",
      "mcpServers": {},
      "name": "frontend-design",
      "version": "unknown"
    },
    "marketing-skills@claude-code-skills": {
      "enabled": false,
      "marketplace": "claude-code-skills",
      "mcpServers": {},
      "name": "marketing-skills",
      "version": "2.2.3"
    },
    "pm-skills@claude-code-skills": {
      "enabled": false,
      "marketplace": "claude-code-skills",
      "mcpServers": {
        "atlassian": {
          "type": "sse",
          "url": "https://mcp.atlassian.com/v1/sse"
        }
      },
      "name": "pm-skills",
      "version": "2.2.3"
    },
    "product-skills@claude-code-skills": {
      "enabled": false,
      "marketplace": "claude-code-skills",
      "mcpServers": {},
      "name": "product-skills",
      "version": "2.3.3"
    },
    "rust-analyzer-lsp@claude-plugins-official": {
      "enabled": false,
      "marketplace": "claude-plugins-official",
      "name": "rust-analyzer-lsp",
      "version": "1.0.0"
    },
    "superpowers@claude-plugins-official": {
      "enabled": true,
      "marketplace": "claude-plugins-official",
      "mcpServers": {},
      "name": "superpowers",
      "version": "5.1.0"
    },
    "vercel@claude-plugins-official": {
      "enabled": true,
      "marketplace": "claude-plugins-official",
      "mcpServers": {
        "vercel": {
          "note": "Official Vercel MCP server. Uses OAuth \u2014 on first connection the agent will be prompted to authorize via Vercel. Read-only in initial release: search docs, list projects/deployments, inspect logs.",
          "type": "http",
          "url": "https://mcp.vercel.com"
        }
      },
      "name": "vercel",
      "version": "0.42.1"
    }
  },
  "source": "claude_plugins",
  "source_paths": [
    "~/.claude/settings.json#enabledPlugins",
    "~/.claude/settings.json#extraKnownMarketplaces",
    "~/.claude/plugins/cache/<marketplace>/<plugin>/<version>/"
  ]
}
