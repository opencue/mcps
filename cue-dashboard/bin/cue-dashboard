#!/usr/bin/env bash
# cue-dashboard — launcher shim for the MCP server.
# Resolves the bun binary at run time so it works from any Claude Code session.

set -e

if [ -x "$HOME/.bun/bin/bun" ]; then
    BUN="$HOME/.bun/bin/bun"
elif command -v bun >/dev/null 2>&1; then
    BUN="$(command -v bun)"
else
    echo "cue-dashboard: bun not found — install from https://bun.sh" >&2
    exit 1
fi

DIR="$(dirname "$(readlink -f "$0")")/.."
exec "$BUN" run "$DIR/server.ts"
